{
	"name": "eatwhilepregnant.com",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/server/index.ts",
		"start": "NODE_ENV=production bun src/server/index.ts",
		"build": "bun build src/web/index.html --outdir dist/web --minify && bun build src/server/index.ts --target=bun --outdir dist/server --minify",
		"typecheck": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.0",
		"ai": "^7.0.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"bun-types": "^1.3.14",
		"typescript": "^6.0.3"
	},
	"engines": {
		"bun": ">=1.1.0"
	}
}
