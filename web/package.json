{
	"name": "eatwhilepregnant.com",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/server/index.ts",
		"start": "NODE_ENV=production bun src/server/index.ts",
		"build": "bun build src/web/index.html --outdir dist/web --minify && bun build src/server/index.ts --target=bun --outdir dist/server --minify",
		"typecheck": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/openai": "^1.3.23",
		"ai": "^4.3.16",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.1",
		"bun-types": "^1.3.14",
		"typescript": "^5.7.2"
	},
	"engines": {
		"bun": ">=1.1.0"
	}
}
